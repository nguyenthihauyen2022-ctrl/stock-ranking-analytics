# SSI MARKET DATA API
# Khóa API của bạn. Không đưa file .env (chứa khóa thật) lên kho mã nguồn.
SSI_API_KEY=YOUR_SSI_API_KEY
SSI_API_SECRET=YOUR_SSI_API_SECRET
SSI_BASE_URL=https://api.ssi.com.vn

# DATABASE
# Mặc định chương trình dùng data/market_data.db (dữ liệu mẫu đi kèm).
# Muốn thu thập dữ liệu mới mà không ghi đè dữ liệu mẫu, bỏ dấu # ở dòng dưới:
# DATABASE_PATH=data/market_data_latest.db

# DATA COLLECTION
BOARDS=HOSE,HNX,UPCOM
MAX_SYMBOLS=0
LOOKBACK_DAYS=450
PAGE_SIZE=1000
REQUEST_DELAY=0.15
MAX_PAGES=100
OVERLAP_DAYS=7
MIN_HISTORY=127
