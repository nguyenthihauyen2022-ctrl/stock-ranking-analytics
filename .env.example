# SSI MARKET DATA API
SSI_API_KEY=YOUR_SSI_API_KEY
SSI_API_SECRET=YOUR_SSI_API_SECRET
SSI_BASE_URL=https://api.ssi.com.vn

# DATABASE
DATABASE_PATH=data/market_data.db

# DATA COLLECTION
BOARDS=HOSE,HNX,UPCOM
MAX_SYMBOLS=0
LOOKBACK_DAYS=450
PAGE_SIZE=1000
REQUEST_DELAY=0.15
MAX_PAGES=100
OVERLAP_DAYS=7
MIN_HISTORY=127